# Pomp Net Panel Configuration
# Based on official MHSanaei/3x-ui v3.8.5

# ============================================
# Panel & Subscription Ports
# ============================================
XUI_PORT=8080
XUI_SUBSCRIPTION_PORT=2026

# ============================================
# Database
# ============================================
XUI_DB_FOLDER=/app/data
XUI_DB_TYPE=sqlite

# For PostgreSQL:
# XUI_DB_TYPE=postgres
# XUI_DB_DSN=postgres://user:password@localhost:5432/xui?sslmode=disable

# ============================================
# Web Configuration
# ============================================
XUI_INIT_WEB_BASE_PATH=/

# ============================================
# Logging
# ============================================
XUI_LOG_LEVEL=info
XUI_DEBUG=false

# ============================================
# Security
# ============================================
XUI_ENABLE_FAIL2BAN=true
XUI_SKIP_HSTS=false

# ============================================
# Render (Auto-detected)
# ============================================
# PORT= (automatically provided by Render)
