# Pomp Net Panel - Configuration
# Based on official MHSanaei/3x-ui v3.8.5
# Real Sanaei backend, database, Xray integration

# ============================================
# Panel & Subscription Ports
# ============================================
XUI_PORT=8080
XUI_SUBSCRIPTION_PORT=2026

# ============================================
# Database Persistence
# ============================================
XUI_DB_FOLDER=/app/data
XUI_DB_TYPE=sqlite
# For PostgreSQL, uncomment and configure:
# XUI_DB_TYPE=postgres
# XUI_DB_DSN=postgres://user:password@127.0.0.1:5432/xui?sslmode=disable

# ============================================
# Web Base Path
# ============================================
XUI_INIT_WEB_BASE_PATH=/

# ============================================
# Logging & Debug
# ============================================
XUI_LOG_LEVEL=info
XUI_DEBUG=false

# ============================================
# Security
# ============================================
XUI_ENABLE_FAIL2BAN=true
XUI_SKIP_HSTS=false

# ============================================
# Render Compatibility
# ============================================
# When deployed on Render, PORT is automatically provided
# PORT=

# ============================================
# Xray Configuration
# ============================================
XRAY_VMESS_AEAD_FORCED=false

# ============================================
# Tunnel Health Monitor (Optional)
# ============================================
# XUI_TUNNEL_HEALTH_MONITOR=false
# XUI_TUNNEL_HEALTH_URL=https://www.cloudflare.com/cdn-cgi/trace
# XUI_TUNNEL_HEALTH_PROXY=
# XUI_TUNNEL_HEALTH_INTERVAL=30s
# XUI_TUNNEL_HEALTH_TIMEOUT=10s
# XUI_TUNNEL_HEALTH_FAILURES=3
# XUI_TUNNEL_HEALTH_COOLDOWN=5m
