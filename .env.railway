# Pomp Net Panel - Railway Configuration
# Production Ready - Real Sanaei Backend
# NOTE: Xray inbound ports NOT exposed on Railway (Platform Limitation)

# ============================================
# Panel Port (Railway Automatic)
# ============================================
# PORT is automatically provided by Railway
# DO NOT set this manually
# Railway binds: 0.0.0.0:$PORT

# ============================================
# Database Persistence (Railway Disk)
# ============================================
XUI_DB_FOLDER=/app/data
XUI_DB_TYPE=sqlite

# ============================================
# Web Configuration
# ============================================
XUI_INIT_WEB_BASE_PATH=/

# ============================================
# Logging
# ============================================
XUI_LOG_LEVEL=info
XUI_DEBUG=false

# ============================================
# Security (Disabled on Railway)
# ============================================
# Fail2ban disabled - Railway handles DDoS protection
XUI_ENABLE_FAIL2BAN=false
XUI_SKIP_HSTS=false

# ============================================
# IMPORTANT RAILWAY LIMITATIONS
# ============================================
# - Xray inbound ports (443, 80, etc) are NOT publicly exposed
# - Only ONE public port available (PORT)
# - Subscription available at: https://domain/sub/[id]
# - For real Xray inbound functionality, use VPS/Dedicated Server
